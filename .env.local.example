# =============================================================================
# Learning OS - LOCAL DEV ONLY
# =============================================================================
# ⚠️  This is a TEMPLATE. Copy to `.env.local` (NOT this file) and fill in
#     real values. `.env.local` is in `.gitignore` and never committed.
#
# Get the Postgres URL from:
#   Supabase Dashboard → Settings → Database → Connection string → Transaction mode
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
LEARNING_OS_POSTGRES_URL="postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Security (REQUIRED for AI provider keys at rest)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
APP_ENCRYPTION_KEY="paste-base64-48-bytes-here"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_TRUSTED_ORIGINS="http://localhost:3000"

# AI defaults (only needed if you want server-side fallback)
# AI_DEFAULT_PROVIDER="openrouter"
# AI_DEFAULT_MODEL="minimax/minimax-m3"
# AI_DEFAULT_BASE_URL="https://openrouter.ai/api/v1"
# AI_DEFAULT_TEMPERATURE="0.4"
# AI_DEFAULT_MAX_TOKENS="2000"
# SERVER_API_KEY_OPENROUTER="sk-or-..."

LOG_LEVEL="info"

# Set to "1" to log every SQL query (verbose, for debugging only)
# LEARNING_OS_PG_DEBUG="1"
