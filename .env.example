# =============================================================================
# Learning OS - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Path to the SQLite database file. Created automatically on first run.
DATABASE_URL="./data/learning-os.db"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 32+ random chars. Used to encrypt persisted AI provider API keys at rest.
# Run `openssl rand -base64 48` to generate one.
APP_ENCRYPTION_KEY="replace-me-with-a-random-48-byte-base64-secret"

# Optional CSRF/origin check token, mainly used when deploying behind a proxy.
APP_TRUSTED_ORIGINS="http://localhost:3000"

# -----------------------------------------------------------------------------
# AI Provider Defaults (server-side defaults; user can override in Settings → AI)
# -----------------------------------------------------------------------------
# Used as fallback when user has not configured AI in Settings.
AI_DEFAULT_PROVIDER="openrouter"
AI_DEFAULT_MODEL="openai/gpt-4o-mini"
AI_DEFAULT_BASE_URL="https://openrouter.ai/api/v1"
AI_DEFAULT_TEMPERATURE="0.4"
AI_DEFAULT_MAX_TOKENS="2000"

# Optional server-side fallback API key. If unset, users must configure their own.
# SERVER_API_KEY_OPENROUTER="sk-or-..."

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_PWA="true"
FEATURE_GLOBAL_AI="true"
FEATURE_DEBUG_DRILL="true"
FEATURE_FAILURE_DRILL="true"
FEATURE_COST_TRACKING="true"
FEATURE_KNOWLEDGE_GAP="true"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL="info"